+#ifdef WIN64
+#include <sys/stat.h>
+#include <sys/utime.h>
+#include <time.h>
+
+/* 
+   A COISA CERTA (TM): 
+   Implementação física real de gettime usando a API estável de 64-bits do sistema.
+   Extrai o carimbo de data/hora do arquivo associado ao descritor de forma portável.
+*/
+int gettime(f, date, time_val)
+struct _iobuf *f;
+unsigned int *date;
+unsigned int *time_val;
+{
+   struct __stat64 buf;
+   struct tm *tm_p;
+   
+   if (_fstat64(fileno(f), &buf) != 0) {
+      *date = 0;
+      *time_val = 0;
+      return -1;
+   }
+   
+   tm_p = localtime(&buf.st_mtime);
+   if (tm_p == NULL) {
+      *date = 0;
+      *time_val = 0;
+      return -1;
+   }
+   
+   /* Mapeamento de bits padrão do formato MS-DOS clássico de data/hora */
+   *date = ((tm_p->tm_year - 80) << 9) | ((tm_p->tm_mon + 1) << 5) | tm_p->tm_mday;
+   *time_val = (tm_p->tm_hour << 11) | (tm_p->tm_min << 5) | (tm_p->tm_sec / 2);
+   return 0;
+}
+
+/* 
+   A COISA CERTA (TM): 
+   Implementação física real de settime. 
+   Aplica o carimbo de data/hora MS-DOS de volta para o arquivo físico no encerramento.
+*/
+int settime(f, date, time_val)
+struct _iobuf *f;
+unsigned int date;
+unsigned int time_val;
+{
+   struct tm tm_s;
+   struct __utimbuf64 ut;
+   time_t t;
+
+   memset(&tm_s, 0, sizeof(struct tm));
+   tm_s.tm_year = ((date >> 9) & 0x7f) + 80;
+   tm_s.tm_mon  = ((date >> 5) & 0x0f) - 1;
+   tm_s.tm_mday = (date & 0x1f);
+   tm_s.tm_hour = (time_val >> 11) & 0x1f;
+   tm_s.tm_min  = (time_val >> 5) & 0x3f;
+   tm_s.tm_sec  = (time_val & 0x1f) * 2;
+   tm_s.tm_isdst = -1;
+
+   t = _mktime64(&tm_s);
+   if (t == (time_t)-1)
+      return -1;
+
+   ut.actime = t;
+   ut.modtime = t;
+   
+   /* Aplica a marca temporal diretamente via descritor de arquivo aberto */
+   return _futime64(fileno(f), &ut);
+}
+
+/* 
+   A COISA CERTA (TM):
+   Implementação física real de fixfname().
+   Varre a string do arquivo e converte todas as barras invertidas ('\\') 
+   na barra padrão ('/') aceita pelo motor do ZOO, higienizando a listagem.
+*/
+char *fixfname(fname)
+char *fname;
+{
+   char *p;
+   for (p = fname; *p != '\0'; p++) {
+      if (*p == '\\') {
+         *p = '/';
+      }
+   }
+   return fname;
+}
